## Examples

**Question:** How many distinct videos are in the dataset?
**SQL:**
SELECT COUNT(DISTINCT coactive_video_id) AS total_videos
FROM coactive_table_adv;

---

**Question:** What is the minimum and maximum probability for the bobsled concept?
**SQL:**
SELECT
  MIN(bobsled_prob) AS min_prob,
  MAX(bobsled_prob) AS max_prob
FROM coactive_table_adv;

---

**Question:** Show me all keyframes where the olympics_games_now probability is above 0.7, ordered by highest score first.
**SQL:**
SELECT
  coactive_image_id,
  coactive_video_id,
  keyframe_time_ms,
  olympics_games_now_prob
FROM coactive_table_adv
WHERE olympics_games_now_prob > 0.7
ORDER BY olympics_games_now_prob DESC;

---

**Question:** Give me a timeline of when ck_angela_ruggiero appears in each video.
**SQL:**
WITH occurrences AS (
  SELECT
    coactive_video_id,
    keyframe_time_ms,
    ck_angela_ruggiero_prob,
    MAX(coactive_image_id) AS coactive_image_id
  FROM coactive_table_adv
  WHERE ck_angela_ruggiero_prob > 0.5
  GROUP BY coactive_video_id, keyframe_time_ms, ck_angela_ruggiero_prob
)
SELECT
  o.coactive_video_id,
  o.keyframe_time_ms,
  o.ck_angela_ruggiero_prob,
  o.coactive_image_id
FROM occurrences o
ORDER BY o.coactive_video_id, o.keyframe_time_ms ASC;

---

**Question:** How many keyframes per video scored above 0.5 for bobsled, and what is the highest score in each video?
**SQL:**
WITH occurrences AS (
  SELECT
    coactive_video_id,
    COUNT(*) AS keyframe_count,
    MAX(bobsled_prob) AS max_probability,
    MIN(bobsled_prob) AS min_probability,
    MAX(coactive_image_id) AS coactive_image_id
  FROM coactive_table_adv
  WHERE bobsled_prob > 0.5
  GROUP BY coactive_video_id
)
SELECT
  o.coactive_video_id,
  o.keyframe_count,
  o.max_probability,
  o.min_probability,
  o.coactive_image_id
FROM occurrences o
ORDER BY o.keyframe_count DESC;

---

**Question:** Tag each video as containing ck_johnny_weir or not, based on having at least 3 keyframes with a probability above 0.5.
**SQL:**
WITH video_level_tab AS (
  SELECT
    coactive_video_id,
    SUM(CASE WHEN ck_johnny_weir_prob > 0.5 THEN 1 ELSE 0 END) AS num_labeled_kfs
  FROM coactive_table_adv
  GROUP BY coactive_video_id
)
SELECT
  coactive_video_id,
  num_labeled_kfs,
  CASE WHEN num_labeled_kfs >= 3 THEN 1 ELSE 0 END AS ck_johnny_weir_tag
FROM video_level_tab
ORDER BY num_labeled_kfs DESC;

---

**Question:** What is the average number of keyframes per video where olympics_games_now probability is above 0.6?
**SQL:**
WITH per_video AS (
  SELECT
    coactive_video_id,
    COUNT(DISTINCT coactive_image_id) AS image_count
  FROM coactive_table_adv
  WHERE olympics_games_now_prob > 0.6
  GROUP BY coactive_video_id
)
SELECT AVG(image_count) AS avg_keyframes_per_video
FROM per_video;

